<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nifraim"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_orange"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="העברת OTP אוטומטית לשרת"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="28dp" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סטטוס"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="הועבר לאחרונה"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/lastForwardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:layoutDirection="ltr" />
            </LinearLayout>
        </LinearLayout>

        <!-- Battery warning -->
        <LinearLayout
            android:id="@+id/batteryWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/warning_bg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אופטימיזציית סוללה פעילה"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/warn_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android עשוי לחסום קבלת SMS ברקע. לחץ להשבתה."
                android:textSize="12sp"
                android:textColor="@color/warn_text" />

            <Button
                android:id="@+id/batteryBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:text="השבת אופטימיזציית סוללה"
                android:textSize="12sp"
                android:backgroundTint="@color/warn_btn"
                android:textColor="@color/white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Enable toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="הפעל העברת SMS"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/enableSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- URL section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="כתובת Webhook"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/urlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://nifraim-production.up.railway.app/api/portal-automation/phone-forward/..."
            android:inputType="textUri"
            android:textSize="12sp"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            android:layout_marginBottom="14dp"
            android:background="@drawable/input_bg"
            android:padding="14dp" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="שמור"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="שלח הודעת בדיקה"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@color/brand_orange"
            android:textSize="14sp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="האפליקציה פועלת ברקע ומעבירה כל SMS שמתקבל לשרת Nifraim שלך. לא נשמרים נתונים במכשיר."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>
