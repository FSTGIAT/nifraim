                                                  <xsd:totalDigits value="5" />
                                                  <xsd:fractionDigits value="2" />
                                                  <xsd:minInclusive value="0" />
                                                </xsd:restriction>
                                              </xsd:simpleType>
                                            </xsd:element>								  
                                            <xsd:element name="SHIUR-KISUY-BEN-NIVHAR" minOccurs="1" nillable="true">
                                              <xsd:annotation>
                                                <xsd:documentation>
                                                  שיעור כיסוי בן נבחר עם מוגבלות
                                                </xsd:documentation>
                                              </xsd:annotation>
                                              <xsd:simpleType>
                                                <xsd:restriction base="xsd:decimal">
                                                  <xsd:totalDigits value="5" />
                                                  <xsd:fractionDigits value="2" />
                                                  <xsd:minInclusive value="0" />
                                                </xsd:restriction>
