                                                </xsd:restriction>
                                              </xsd:simpleType>
                                            </xsd:element>
                                            <xsd:element name="DMI-NIHUL-YECHCIM-NOKO-MEHAFKADA" minOccurs="1" nillable="true">
                                              <xsd:annotation>
