												</xsd:annotation>
												<xsd:simpleType>
													<xsd:restriction base="xsd:date">
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
                                            <xsd:element name="KOD-MASLUL-BITUAH" minOccurs="1" nillable="true">
