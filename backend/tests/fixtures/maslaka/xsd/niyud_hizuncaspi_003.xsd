                                      <xsd:element name="TkufatHachsara" minOccurs="0" maxOccurs="unbounded">
                                        <xsd:complexType>
                                          <xsd:sequence>									  
                                           <xsd:element name="SUG-IDKUN-BITUAH" minOccurs="1" nillable="true">
                                              <xsd:annotation>
                                                <xsd:documentation>
												סוג עדכון ביטוח 
												ערכים מוגדרים בלבד :
												1 = הצטרפות או חידוש ביטוח בקרן 
												2 = חידוש ביטוח שאירים ונכות
												3 = חידוש ביטוח שאירים בלבד - כולל שמירה על תקופת אכשרה
												4 = חידוש ביטוח שאירים לבן/בת זוג בלבד - כולל שמירה על תקופת אכשרה
												5 = חידוש ביטוח נכות בלבד
												6 = ויתור על כיסוי שאירים 
												7 = ויתור על כיסוי שאירים לבן/בת זוג
												8 = שינוי גיל סיום ביטוח
												9 = שינוי קצבת נכות
												10 = שינוי מסלול ביטוח
												11 = הפסקת ביטוח
												12 = חידוש ביטוח שאירים - ללא שמירה על אכשרה
												13 = חידוש ביטוח שאירים לבן/בת זוג - ללא שמירה על אכשרה
												14 = ויתור על כיסוי שאירים - ללא שמירה על תקופת אכשרה
												15 = ויתור על כיסוי שאירים לבן/בת זוג ללא שמירה על תקופת אכשרה
                                                </xsd:documentation>
                                              </xsd:annotation>
                                              <xsd:simpleType>
                                                <xsd:restriction base="xsd:int">
                                                  <xsd:enumeration value="1" />
                                                  <xsd:enumeration value="2" />
                                                  <xsd:enumeration value="3" />
                                                  <xsd:enumeration value="4" />
                                                  <xsd:enumeration value="5" />
                                                  <xsd:enumeration value="6" />												  
                                                  <xsd:enumeration value="7" />												  
                                                  <xsd:enumeration value="8" />												  
                                                  <xsd:enumeration value="9" />												  
                                                  <xsd:enumeration value="10" />												  
                                                  <xsd:enumeration value="11" />	
                                                  <xsd:enumeration value="12" />
                                                  <xsd:enumeration value="13" />
                                                  <xsd:enumeration value="14" />
                                                  <xsd:enumeration value="15" />												  
                                                </xsd:restriction>
                                              </xsd:simpleType>
                                            </xsd:element>
                                            <xsd:element name="SHIUR-KISUY-YATOM" minOccurs="1">
