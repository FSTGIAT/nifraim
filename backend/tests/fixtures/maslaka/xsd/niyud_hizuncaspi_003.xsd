                      <xsd:annotation>
                        <xsd:documentation>
                          ערכים:
                          1 = יצרן
                          2 = מסלקה
                          3 = מפיץ
                          4 = לקוח
                          5 = מעסיק
                          6 = לשכת שירות
                          8 = חברה מנהלת קופה מקבלת
                          9 = חברה מנהלת קופה מעבירה
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:int">
                          <xsd:enumeration value="2" />
                          <xsd:enumeration value="8" />
                          <xsd:enumeration value="9" />
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="SUG-MEZAHE-SHOLECH" minOccurs="1">
