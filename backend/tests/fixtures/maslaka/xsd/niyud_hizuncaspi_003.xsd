                                              <xsd:simpleType>
                                                <xsd:restriction base="xsd:int">
                                                  <xsd:totalDigits value="3" />
                                                  <xsd:minInclusive value="0" />
                                                </xsd:restriction>
                                              </xsd:simpleType>
